# Runtime de portfolio
APP_ENV=development
CATALOG_BACKEND=demo_postgres
WHATSAPP_ENABLED=false
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio_repuestos

# Proveedor LLM
GEMINI_API_KEY=replace_with_secret
LLM_MODEL=gemini/gemini-2.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# Paneles privados (usar secretos distintos y fuertes)
ADMIN_PASSWORD=replace_with_long_random_secret
ADMIN_PARAMETROS=replace_with_another_long_random_secret

# Demo pública y control de costos
DEMO_ENABLED=true
DEMO_MAX_MESSAGES_PER_SESSION=12
DEMO_MAX_MESSAGES_PER_IP_DAY=30
DEMO_GLOBAL_MESSAGES_PER_DAY=500
DEMO_MAX_MESSAGE_LENGTH=1000
DEMO_SESSION_TTL_SECONDS=3600
DEMO_RETENTION_DAYS=7
DEMO_TRUST_FORWARDED_FOR=false
METAIA_CTA_URL=https://metaia.pro/

PORT=8000
LOG_LEVEL=INFO
